# Copy this to .env.local and fill in the values below.
# Get Supabase values from: supabase.com → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Shared Supabase Auth email used by the access-code login screen.
# The access code is the password for this Supabase Auth user.
NEXT_PUBLIC_SHARED_AUTH_EMAIL=shared-user@example.com

# Comma-separated emails allowed in Supabase database-level authorization.
# The shared auth email above must also be included here.
NEXT_PUBLIC_ALLOWED_EMAILS=kavinrajt@gmail.com,praveenslbd@gmail.com
