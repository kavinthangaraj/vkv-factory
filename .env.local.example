# Copy this to .env.local and fill in your two Supabase values.
# Get them from: supabase.com → your project → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Comma-separated list of Gmail addresses allowed to log in
NEXT_PUBLIC_ALLOWED_EMAILS=kavinrajt@gmail.com,brothers_email@gmail.com
